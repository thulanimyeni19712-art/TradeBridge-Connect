rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'thulanimyeni19712@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLicense(data) {
      return data.keys().hasAll(['id', 'key', 'robotName', 'accountNumber', 'clientName', 'status']) &&
        data.keys().hasOnly([
          'id', 'key', 'robotName', 'accountNumber', 'hwid', 'clientName',
          'clientEmail', 'broker', 'status', 'createdAt', 'expiresAt',
          'maxAccounts', 'activeAccounts'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.key is string && data.key.size() <= 128 &&
        data.robotName is string && data.robotName.size() <= 64 &&
        data.accountNumber is string && data.accountNumber.size() <= 32 &&
        data.clientName is string && data.clientName.size() <= 128 &&
        data.status in ['ACTIVE', 'EXPIRED', 'REVOKED', 'PENDING'];
    }

    function isValidTerminal(data) {
      return data.keys().hasAll(['id', 'platform', 'broker', 'accountNumber', 'status']) &&
        data.keys().hasOnly([
          'id', 'name', 'platform', 'broker', 'accountNumber', 'server',
          'pingMs', 'status', 'balance', 'equity', 'margin', 'autoTrading', 'lastPing'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.platform in ['MT4', 'MT5', 'cTrader', 'DXtrade'] &&
        data.broker is string && data.broker.size() <= 64 &&
        data.accountNumber is string && data.accountNumber.size() <= 32 &&
        data.status in ['ONLINE', 'OFFLINE', 'SYNCING', 'ERROR'];
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'adminEmail', 'action', 'timestamp']) &&
        data.keys().hasOnly(['id', 'adminEmail', 'action', 'target', 'details', 'timestamp', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.adminEmail is string && data.adminEmail.size() <= 128 &&
        data.action is string && data.action.size() <= 64 &&
        data.timestamp is string && data.timestamp.size() <= 40;
    }

    function isValidWorkspace(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'updatedAt', 'accountBalance', 'positionsJson',
          'pendingOrdersJson', 'orderHistoryJson', 'licensesJson', 'automatedSettingsJson'
        ]) &&
        data.uid == userId &&
        data.updatedAt is string && data.updatedAt.size() <= 40 &&
        (!('accountBalance' in data) || data.accountBalance is number) &&
        (!('positionsJson' in data) || (data.positionsJson is string && data.positionsJson.size() <= 200000)) &&
        (!('pendingOrdersJson' in data) || (data.pendingOrdersJson is string && data.pendingOrdersJson.size() <= 100000)) &&
        (!('orderHistoryJson' in data) || (data.orderHistoryJson is string && data.orderHistoryJson.size() <= 200000)) &&
        (!('licensesJson' in data) || (data.licensesJson is string && data.licensesJson.size() <= 100000)) &&
        (!('automatedSettingsJson' in data) || (data.automatedSettingsJson is string && data.automatedSettingsJson.size() <= 50000));
    }

    // Licenses collection: admin full access; verified client can read own email-scoped license
    match /licenses/{licenseId} {
      allow get: if isValidId(licenseId) && (isAdmin() || (isSignedIn() && resource.data.clientEmail == request.auth.token.email));
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(licenseId) && isValidLicense(request.resource.data);
      allow delete: if isAdmin() && isValidId(licenseId);
    }

    // Terminals collection: admin fleet only
    match /terminals/{terminalId} {
      allow get, list: if isAdmin() && isValidId(terminalId);
      allow create, update: if isAdmin() && isValidId(terminalId) && isValidTerminal(request.resource.data);
      allow delete: if isAdmin() && isValidId(terminalId);
    }

    // Audit logs collection: immutable audit trail; admin can read/manage, signed-in user can append own log
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || (isSignedIn() && resource.data.adminEmail == request.auth.token.email));
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(request.resource.data) &&
        (isAdmin() || request.resource.data.adminEmail == request.auth.token.email);
      allow update, delete: if isAdmin() && isValidId(logId);
    }

    // Per-user workspaces: strict owner-only isolation
    match /users/{userId}/workspaces/{workspaceId} {
      allow get, list: if isOwner(userId) && isValidId(workspaceId);
      allow create: if isOwner(userId) && isValidId(workspaceId) && isValidWorkspace(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(workspaceId) && isValidWorkspace(request.resource.data, userId) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId) && isValidId(workspaceId);
    }
  }
}
