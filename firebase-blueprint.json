{
  "entities": {
    "License": {
      "title": "AlgoMax License",
      "description": "Client software license key for AlgoMax EA automated trading bot",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "key": { "type": "string", "maxLength": 128 },
        "robotName": { "type": "string", "maxLength": 64 },
        "accountNumber": { "type": "string", "maxLength": 32 },
        "hwid": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 128 },
        "broker": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED", "REVOKED", "PENDING"] },
        "createdAt": { "type": "string", "maxLength": 32 },
        "expiresAt": { "type": "string", "maxLength": 32 },
        "maxAccounts": { "type": "number" },
        "activeAccounts": { "type": "number" }
      },
      "required": ["id", "key", "robotName", "accountNumber", "clientName", "status"]
    },
    "Terminal": {
      "title": "Client Terminal VPS",
      "description": "Connected MT4/MT5 client node monitored via Algo Admin Portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "platform": { "type": "string", "enum": ["MT4", "MT5", "cTrader", "DXtrade"] },
        "broker": { "type": "string", "maxLength": 64 },
        "accountNumber": { "type": "string", "maxLength": 32 },
        "server": { "type": "string", "maxLength": 64 },
        "pingMs": { "type": "number" },
        "status": { "type": "string", "enum": ["ONLINE", "OFFLINE", "SYNCING", "ERROR"] },
        "balance": { "type": "number" },
        "equity": { "type": "number" },
        "margin": { "type": "number" },
        "autoTrading": { "type": "boolean" },
        "lastPing": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "platform", "broker", "accountNumber", "status"]
    },
    "AuditLog": {
      "title": "Admin Audit Log",
      "description": "Security and command audit records generated by Algo Admin Portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 64 },
        "target": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 512 },
        "timestamp": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "adminEmail", "action", "timestamp"]
    },
    "UserWorkspace": {
      "title": "User Trading Workspace",
      "description": "Real-time per-user persisted trading state, positions, order history, and EA configs",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 40 },
        "accountBalance": { "type": "number" },
        "positionsJson": { "type": "string", "maxLength": 200000 },
        "pendingOrdersJson": { "type": "string", "maxLength": 100000 },
        "orderHistoryJson": { "type": "string", "maxLength": 200000 },
        "licensesJson": { "type": "string", "maxLength": 100000 },
        "automatedSettingsJson": { "type": "string", "maxLength": 50000 }
      },
      "required": ["uid", "updatedAt"]
    }
  },
  "firestore": {
    "/licenses/{licenseId}": {
      "schema": "License",
      "description": "AlgoMax client license keys and hardware authorizations"
    },
    "/terminals/{terminalId}": {
      "schema": "Terminal",
      "description": "Monitored MetaTrader client VPS instances"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative actions executed by Algo Admin Portal"
    },
    "/users/{userId}/workspaces/{workspaceId}": {
      "schema": "UserWorkspace",
      "description": "Per-user persisted trading positions, history, and automation settings"
    }
  }
}
